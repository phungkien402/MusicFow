<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="0"
        android:translateY="0">
        <!-- Vinyl Record / Outer Disc -->
        <path
            android:fillColor="#1E293B"
            android:pathData="M 54,26 A 28,28 0 1,0 54,82 A 28,28 0 1,0 54,26" />
        
        <!-- Groove ring 1 -->
        <path
            android:strokeColor="#334155"
            android:strokeWidth="1.2"
            android:pathData="M 54,32 A 22,22 0 1,0 54,76 A 22,22 0 1,0 54,32" />

        <!-- Groove ring 2 -->
        <path
            android:strokeColor="#475569"
            android:strokeWidth="1.0"
            android:pathData="M 54,38 A 16,16 0 1,0 54,70 A 16,16 0 1,0 54,38" />

        <!-- Vibrant Center Disc Gradient -->
        <path
            android:pathData="M 54,43 A 11,11 0 1,0 54,65 A 11,11 0 1,0 54,43">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="43"
                    android:startY="43"
                    android:endX="65"
                    android:endY="65"
                    android:type="linear">
                    <item android:color="#00F5FF" android:offset="0.0"/>
                    <item android:color="#A855F7" android:offset="1.0"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Center spindle hole -->
        <path
            android:fillColor="#0F172A"
            android:pathData="M 54,51 A 3,3 0 1,0 54,57 A 3,3 0 1,0 54,51" />

        <!-- Modern Waveform Bars over the disc -->
        <!-- Bar 1 -->
        <path
            android:fillColor="#38BDF8"
            android:pathData="M 32,48 L 35,48 L 35,60 L 32,60 Z" />
        <!-- Bar 2 -->
        <path
            android:fillColor="#00E5FF"
            android:pathData="M 38,42 L 41,42 L 41,66 L 38,66 Z" />
        <!-- Bar 3 -->
        <path
            android:fillColor="#F43F5E"
            android:pathData="M 67,42 L 70,42 L 70,66 L 67,66 Z" />
        <!-- Bar 4 -->
        <path
            android:fillColor="#EC4899"
            android:pathData="M 73,48 L 76,48 L 76,60 L 73,60 Z" />

        <!-- Download arrow badge at bottom right -->
        <path
            android:fillColor="#10B981"
            android:pathData="M 68,66 A 11,11 0 1,0 68,88 A 11,11 0 1,0 68,66" />
        <!-- Arrow glyph inside badge -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 67,71 L 69,71 L 69,78 L 72,78 L 68,83 L 64,78 L 67,78 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 64,84 L 72,84 L 72,85.5 L 64,85.5 Z" />
    </group>
